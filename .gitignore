# hidden files
.*
!.git*
!.editorconfig

# build output
_site
.jekyll-cache
.jekyll-metadata

# bundler install path -- anchored to the repo root on purpose.
# A bare `vendor` also matches _sass/vendor/, which is theme source
# (font-awesome, susy, breakpoint) and must stay tracked.
/vendor

# rubygem
*.gem

# npm dependencies
node_modules
package-lock.json
